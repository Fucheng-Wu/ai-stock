# Agent 操作的工作目录；启动脚本默认设置为 ai-stock 仓库根目录。
PI_WORKSPACE_DIR=D:\path\to\ai-stock

# Pi 的模型、认证和会话配置目录；留空时使用 ~/.pi/agent。
# PI_AGENT_DIR=C:\Users\orange\.pi\agent

HOST=127.0.0.1
PORT=3000

# 新会话默认使用 DeepSeek Flash。
# 可填写模型设置中 deepseek Provider 下的其他模型 ID。
AGENT_DEFAULT_MODEL=deepseek-flash
# 在这里填写 Key，或在 Agent 设置的 DeepSeek Provider 中配置认证。
# Java 股票分析服务的参数设置不会自动同步到独立运行的 Agent Gateway。
DEEPSEEK_API_KEY=

# 登录鉴权及股票业务工具共用的若依后端地址，可包含 context-path；不填写 /prod-api 或 /dev-api。
# 网关用 /getInfo 校验握手令牌和 agent:chat:use 权限，并按当前用户隔离会话。
# 工具使用已校验的连接令牌，无需配置管理员账号或静态 Token。
STOCK_API_BASE_URL=http://127.0.0.1:8080

# 股票子代理的公开联网搜索（Tavily）；不配置时仅联网搜索不可用。
# 密钥只保留在服务端环境中，不通过聊天或工具参数传递。
TAVILY_API_KEY=

# 与若依使用同一个 MySQL 实例和数据库。
AGENT_DB_HOST=127.0.0.1
AGENT_DB_PORT=3306
AGENT_DB_NAME=ai_stock
AGENT_DB_USER=root
AGENT_DB_PASSWORD=change-me
AGENT_DB_CONNECTION_LIMIT=5

