PI_WORKSPACE_DIR=/home/wufc/ai-stock/workspace
PI_AGENT_DIR=/home/wufc/.pi/agent

HOST=127.0.0.1
PORT=3000

# 新会话默认使用 DeepSeek；也可在 Agent 设置中配置 DeepSeek 认证。
AGENT_DEFAULT_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# 若依后端直连地址；业务工具使用当前工作台用户身份。
STOCK_API_BASE_URL=http://127.0.0.1:8080
# 同时用于 /getInfo 登录鉴权；普通聊天也必须能访问若依后端。

# 股票子代理联网搜索；可选，不配置不影响股票业务工具。
TAVILY_API_KEY=

# 全市场520筛选使用上面的 STOCK_API_BASE_URL，通过 Java API 读取 MySQL。
# 先执行 stock_market.sql / stock_market_jobs.sql 并导入历史；无需本地快照目录。

AGENT_DB_HOST=127.0.0.1
AGENT_DB_PORT=3306
AGENT_DB_NAME=ai_stock
AGENT_DB_USER=agent_gateway
AGENT_DB_PASSWORD=CHANGE_ME
AGENT_DB_CONNECTION_LIMIT=5
